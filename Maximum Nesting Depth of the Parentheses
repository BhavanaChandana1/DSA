class Solution {
    public int maxDepth(String s) {
        int depth=0;
        int maxdepth=0;
        for(int i=0;i<s.length();i++){
            char a = s.charAt(i);
            if(a=='('){
                depth++;
                maxdepth=Math.max(depth,maxdepth);
            }else if(a==')'){
                depth--;
            }
        }
        return maxdepth;
    }
}
