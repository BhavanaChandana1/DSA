class Solution {
    public int[] searchRange(int[] nums, int target) {
        int first=-1;
        int last=-1;
        int start=0, end=nums.length-1;
        while(start<=end){ //O(log n)
            int mid=start + (end-start)/2;
            if(nums[mid]==target){
                if(first==-1 || mid<first){
                    first=mid;
                }
                end=mid-1;
            }else if(nums[mid]>target){
                    end=mid-1;
            }else{
                    start=mid+1;
            }
                
        }
        start=0;
         end=nums.length-1;
        while(start<=end){ //O(log n)
            int mid=start + (end-start)/2;
            if(nums[mid]==target){
                if(last==-1 || mid>last){
                    last=mid;
                }
                start=mid+1;
            }else if(nums[mid]>target){
                end=mid-1;
            }else{
                start=mid+1;
            }
           
        }

        return new int[]{first,last};


        
    }
}
