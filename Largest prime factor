class Solution {
    static int largestPrimeFactor(int n) {
        // code here
        int large=-1;
        while(n%2==0){ // O(log n) 
            n/=2;
            large=2;
        }
        for(int i=3;i*i<=n;i+=2){ //O(sqrt(n))
            while(n%i==0){
                large=i;
                n/=i;
            }
        }
        if(n>1)
            large=n;
            
        return large;
    }
}
