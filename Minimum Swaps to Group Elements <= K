//Sliding window
class Solution {
    int minSwap(int[] arr, int k) {
        int n=arr.length;
        int count=0;
        for(int x:arr){
            if(x<=k){
                count++;
            }
        }
        //Edge cases
        if(count==0 || count==n){
            return 0;
        }
        int bad=0;
        for(int i=0;i<count;i++){
            if(arr[i]>k){
                bad++;
            }
        }
        int minSwaps=bad;
        for(int i=count;i<n;i++){
            if(arr[i-count]>k){
                bad--;
            }
            if(arr[i]>k){
                bad++;
            }
            minSwaps=Math.min(minSwaps,bad);
        }
        return minSwaps;
        
       
    }
}


//time-O(n^2),s-O(1)
class Solution {
    int minSwap(int[] arr, int k) {
        // Code Here
        int count=0;
        for(int i=0;i<arr.length;i++){
            if(arr[i]<=k){
               count++;
                
            }
        }
        int swap=count;
        for(int i=0;i<=(arr.length-count);i++){
            int num=0;
            for(int j=i;j<(i+count);j++){
                if(arr[j]>k){
                    num++;
                }
            }
            if(num<swap){
                swap=num;
            }
        }
        return swap;
    }
}
