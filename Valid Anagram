class Solution {
    public boolean isAnagram(String s, String t) {
        if(s.length()!=t.length()){
            return false;
        }
        int[] count = new int[26];
        for(int i=0;i<s.length();i++){
            count[s.charAt(i)-'a']++;
            count[t.charAt(i)-'a']--;
        }
        for(int n:count){
            if(n!=0){
                return false;
            }
        }

        return true;
        
    }
}



class Solution {
    public boolean isAnagram(String s, String t) {
        char a[]=s.toCharArray();
        char b[]=t.toCharArray();
        int[] arr1=new int[26];
        int[] arr2=new int[26];
        for(char c:a){
            int asci=(int) c - 97;
            arr1[asci]++;
        }
        for(char c:b){
            int asci=(int) c - 97;
            arr2[asci]++;
        }
        for(int i=0;i<arr1.length;i++){
            if(arr1[i]!=arr2[i]){
                return false;
            }
        }
        return true;
        
    }
}
