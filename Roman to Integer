//Greedy approach
class Solution {
    public int romanToInt(String s) {
       int sum=0;
       for(int i=0;i<s.length();i++){
        int current=value(s.charAt(i));
        if(i+1<s.length() && current < value(s.charAt(i+1))){
            sum-=current;
        }else{
            sum+=current;
        }
       }
       return sum;
    }

    private int value(char c){
        switch(c){
            case 'I':return 1;
            case 'V':return 5;
            case 'X':return 10;
            case 'L':return 50;
            case 'C':return 100;
            case 'D':return 500;
            case 'M':return 1000;
            default:return 0;
        }
    }
}


//t-O(n),s-O(n)- char array ch based on string length
class Solution {
    public int romanToInt(String s) {
        char[] ch=s.toCharArray();
        int sum=0;
        char a='a';
        for(char c:ch){
            if(c=='I'){
                sum+=1;
            }else if(c=='V'){
                if(a=='I'){
                    sum+=-2;
                }
                sum+=5;
            }else if(c=='X'){
                if(a=='I'){
                    sum+=-2;
                }
                sum+=10;
            }else if(c=='L'){
                if(a=='X'){
                    sum+=-20;
                }
                sum+=50;
            }else if(c=='C'){
                if(a=='X'){
                    sum+=-20;
                }
                sum+=100;
            }else if(c=='D'){
                if(a=='C'){
                    sum+=-200;
                }
                sum+=500;
            }else if(c=='M'){
                if(a=='C'){
                    sum+=-200;
                }
                sum+=1000;
            }
            a=c;

        }
        return sum;
    }
}
