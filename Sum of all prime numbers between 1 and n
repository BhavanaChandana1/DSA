//Sieve of Eratosthenes
//time - O(n log log n)
//space - O(n)
class Solution {
    public int prime_Sum(int n) {
     boolean[] arr= new boolean[n+1];
     for(int i=2;i<=n;i++){
         arr[i]=true;
     }
     for(int i=2;i*i<=n;i++){
         if(arr[i]==true){
             for(int j=i*i;j<=n;j+=i){
                 arr[j]=false;
             
             }
         }
     }
     int sum=0;
     for(int i=1;i<=n;i++){
        if(arr[i]==true){
            sum+=i;
        }
     }
     return sum;
     
        
        
    }
}





