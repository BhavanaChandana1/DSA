class Solution {
    public ArrayList<Integer> getDivisors(int n) {
        // code here
        ArrayList<Integer> a = new ArrayList<>();
        ArrayList<Integer> b = new ArrayList<>();
        for(int i=1;i*i<=n;i++){  //O(sqt(n))
            if(n%i==0){
                a.add(i);
                if(i!=(n/i)){
                b.add(n/i);
                }
            }
        }   
        //Collections.sort(a); --O(k Log k)
        //Also sort through comparator
        for(int i=b.size()-1;i>=0;i--){ // O(k)-k divisors
            a.add(b.get(i));
        }
        return a;
    }
}
