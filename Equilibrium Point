class Solution {
    public static int findEquilibrium(int arr[]) {
        // code here
        int before =0;
        int after = 0;
        int sum=0;
        for(int i=0; i<arr.length;i++){
            sum+=arr[i];
        }
        for(int i=0; i<arr.length;i++){
            after=sum-before-arr[i];
            if(before==after){
                return i;
            }
            before+=arr[i];
        }
        return -1;
    }
}
