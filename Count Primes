class Solution {
    public int countPrimes(int n) {
        boolean[] arr = new boolean[n];
        for(int i=2;i<=n-1;i++){
            arr[i]=true;
        }
        for(int i=2;i*i<=n-1;i++){
            if(arr[i]==true){
                for(int j=i*i;j<=n-1;j+=i){
                    arr[j]=false;
                
            }

            }
            
        }
        int count=0;
        for(int i=0;i<=n-1;i++){
            if(arr[i]==true)
                count++;
        }
        return count;
        
    }
}
